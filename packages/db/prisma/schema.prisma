// This is the Prisma schema for the Enterprise Financial Dashboard.
// All monetary values stored as BigInt (cents) — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js required models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core application models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships          Membership[]
  financialAccounts    FinancialAccount[]
  auditLogs            AuditLog[]
  netWorthSnapshots    NetWorthSnapshot[]
  goals                Goal[]
  budgets              Budget[]
  insights             Insight[]
  creditScores         CreditScore[]
  creditAccounts       CreditAccount[]
  creditHistory        CreditHistory[]
  debtAccounts         DebtAccount[]
  payoffStrategies     PayoffStrategy[]
  payoffPlans          PayoffPlan[]
  alertRules           AlertRule[]
  alertHistory         AlertHistory[]
  spendingForecasts    SpendingForecast[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  password        String?
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  mfaSecrets           MfaSecret[]
  auditLogs            AuditLog[]
  financialAccounts    FinancialAccount[]
  netWorthSnapshots    NetWorthSnapshot[]
  goals                Goal[]
  budgets              Budget[]
  insights             Insight[]
  creditScores         CreditScore[]
  creditAccounts       CreditAccount[]
  creditHistory        CreditHistory[]
  debtAccounts         DebtAccount[]
  payoffStrategies     PayoffStrategy[]
  payoffPlans          PayoffPlan[]
  alertRules           AlertRule[]
  alertHistory         AlertHistory[]
  spendingForecasts    SpendingForecast[]

  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id") @db.Uuid
  expires       DateTime
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model MfaSecret {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  encryptedSecret String   @map("encrypted_secret")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model FinancialAccount {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  type            String
  balanceCurrent  BigInt   @default(0) @map("balance_current")
  isoCurrencyCode String   @default("USD") @map("iso_currency_code")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  holdings     Holding[]
  liability    Liability?

  @@index([organizationId])
  @@index([userId])
  @@map("financial_accounts")
}

model Transaction {
  id                 String   @id @default(uuid()) @db.Uuid
  financialAccountId String   @map("financial_account_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  amount             BigInt
  isoCurrencyCode    String   @default("USD") @map("iso_currency_code")
  date               DateTime @db.Date
  name               String
  merchantName       String?  @map("merchant_name")
  customCategory     String?  @map("custom_category")
  pending            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  account FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([financialAccountId])
  @@index([date])
  @@map("transactions")
}

model Security {
  id              String    @id @default(uuid()) @db.Uuid
  securityId      String    @unique @map("security_id")
  name            String
  tickerSymbol    String?   @map("ticker_symbol")
  type            String
  isoCurrencyCode String    @default("USD") @map("iso_currency_code")
  closePrice      BigInt?   @map("close_price")
  closePriceAsOf  DateTime? @map("close_price_as_of") @db.Date
  updatedAt       DateTime  @updatedAt @map("updated_at")

  holdings Holding[]

  @@map("securities")
}

model Holding {
  id                 String   @id @default(uuid()) @db.Uuid
  financialAccountId String   @map("financial_account_id") @db.Uuid
  securityId         String   @map("security_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  quantity           Decimal  @db.Decimal(20, 8)
  institutionValue   BigInt   @map("institution_value")
  costBasis          BigInt?  @map("cost_basis")
  isoCurrencyCode    String   @default("USD") @map("iso_currency_code")
  updatedAt          DateTime @updatedAt @map("updated_at")

  account  FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  security Security         @relation(fields: [securityId], references: [id])

  @@unique([financialAccountId, securityId])
  @@index([organizationId])
  @@map("holdings")
}

model Liability {
  id                 String   @id @default(uuid()) @db.Uuid
  financialAccountId String   @unique @map("financial_account_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  type               String
  metadata           Json?
  updatedAt          DateTime @updatedAt @map("updated_at")

  account FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("liabilities")
}

model NetWorthSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  totalAssets    BigInt   @map("total_assets")
  totalLiabilities BigInt @map("total_liabilities")
  netWorth       BigInt   @map("net_worth")
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  breakdown      Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

model Goal {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String
  targetAmount     BigInt   @map("target_amount")
  currentAmount    BigInt   @default(0) @map("current_amount")
  targetDate       DateTime @map("target_date") @db.Date
  contributionRate Decimal  @default(0) @map("contribution_rate") @db.Decimal(20, 2)
  linkedAccountIds String[] @map("linked_account_ids")
  isCompleted      Boolean  @default(false) @map("is_completed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("goals")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  month          Int
  year           Int
  rollover       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   BudgetCategory[]

  @@unique([organizationId, userId, month, year])
  @@map("budgets")
}

model BudgetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  category    String
  limitAmount BigInt   @map("limit_amount")
  spentAmount BigInt   @default(0) @map("spent_amount")
  updatedAt   DateTime @updatedAt @map("updated_at")

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@map("budget_categories")
}

model Insight {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String    @db.Text
  severity       String    @default("info")
  actionItems    String[]  @map("action_items")
  toolCallLog    Json      @map("tool_call_log")
  modelId        String    @map("model_id")
  promptHash     String    @map("prompt_hash")
  inputTokens    Int       @map("input_tokens")
  outputTokens   Int       @map("output_tokens")
  helpful        Boolean?
  generatedAt    DateTime  @default(now()) @map("generated_at")
  expiresAt      DateTime  @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([expiresAt])
  @@map("insights")
}

// ---------------------------------------------------------------------------
// Credit Score and Credit History models
// ---------------------------------------------------------------------------

model CreditScore {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  score              Int
  scoreDate          DateTime @map("score_date") @db.Date
  paymentHistory     Int      @default(0) @map("payment_history")
  creditUtilization  Int      @default(0) @map("credit_utilization")
  creditAge          Int      @default(0) @map("credit_age")
  derogatoryMarks    Int      @default(0) @map("derogatory_marks")
  hardInquiries      Int      @default(0) @map("hard_inquiries")
  totalAccounts      Int      @default(0) @map("total_accounts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([scoreDate])
  @@map("credit_scores")
}

model CreditAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  accountName        String   @map("account_name")
  accountType        String   @map("account_type")
  accountNumber      String   @map("account_number")
  creditor           String
  balance            BigInt   @map("balance")
  creditLimit        BigInt?  @map("credit_limit")
  accountStatus      String   @default("open") @map("account_status")
  paymentStatus      String   @default("current") @map("payment_status")
  monthlyPayment     BigInt?  @map("monthly_payment")
  openDate           DateTime @map("open_date") @db.Date
  lastPaymentDate    DateTime? @map("last_payment_date") @db.Date
  nextPaymentDue     DateTime? @map("next_payment_due") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([accountType])
  @@map("credit_accounts")
}

model CreditHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  creditAccountId    String   @map("credit_account_id")
  eventType          String   @map("event_type")
  eventDate          DateTime @map("event_date") @db.Date
  eventDescription   String   @map("event_description") @db.Text
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([creditAccountId])
  @@index([eventDate])
  @@map("credit_history")
}

// ---------------------------------------------------------------------------
// Debt Payoff Strategy models
// ---------------------------------------------------------------------------

model DebtAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  accountName        String   @map("account_name")
  accountType        String   @map("account_type") // credit_card, personal_loan, auto_loan, mortgage, student_loan
  currentBalance     BigInt   @map("current_balance") // in cents
  minimumPayment     BigInt   @map("minimum_payment") // in cents
  interestRate       Decimal  @map("interest_rate") @db.Decimal(5, 2) // e.g., 18.5
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoffStrategies PayoffStrategy[]
  payoffPlans      PayoffPlan[]

  @@index([organizationId, userId])
  @@index([accountType])
  @@map("debt_accounts")
}

model PayoffStrategy {
  id                 String   @id @default(uuid()) @db.Uuid
  debtAccountId      String   @map("debt_account_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  strategyType       String   // avalanche or snowball
  monthlyPaymentAmount BigInt @map("monthly_payment_amount") // in cents
  projectedPayoffMonths Int  @map("projected_payoff_months")
  totalInterestPaid  BigInt   @map("total_interest_paid") // in cents
  payoffDate         DateTime @map("payoff_date") @db.Date
  schedule           Json     // array of {month, balance, interest, principal, payment}
  createdAt          DateTime @default(now()) @map("created_at")

  debtAccount DebtAccount @relation(fields: [debtAccountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debtAccountId])
  @@index([organizationId, userId])
  @@map("payoff_strategies")
}

model PayoffPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  debtAccountId      String   @map("debt_account_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  strategyType       String   // avalanche or snowball
  monthlyPaymentAmount BigInt @map("monthly_payment_amount") // in cents
  startDate          DateTime @map("start_date") @db.Date
  projectedPayoffDate DateTime @map("projected_payoff_date") @db.Date
  isActive           Boolean  @default(true) @map("is_active")
  totalInterestSaved BigInt   @default(0) @map("total_interest_saved") // in cents
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  debtAccount DebtAccount @relation(fields: [debtAccountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([isActive])
  @@map("payoff_plans")
}

// ---------------------------------------------------------------------------
// Alert and Threshold models
// ---------------------------------------------------------------------------

model AlertRule {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  name               String
  ruleType           String   // budget_breach, spending_threshold, large_transaction, bill_due
  conditionType      String   // greater_than, less_than, equals, percentage_increase
  threshold          BigInt   @map("threshold") // in cents for monetary thresholds
  isEnabled          Boolean  @default(true) @map("is_enabled")
  notificationMethod String   @default("email") @map("notification_method") // email, in_app, both
  metadata           Json?    // additional config for specific rule types
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertHistory AlertHistory[]

  @@index([organizationId, userId])
  @@index([ruleType])
  @@index([isEnabled])
  @@map("alert_rules")
}

model AlertHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  alertRuleId        String   @map("alert_rule_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  triggerValue       BigInt?  @map("trigger_value") // the actual value that triggered the alert
  message            String   @db.Text
  wasViewed          Boolean  @default(false) @map("was_viewed")
  triggeredAt        DateTime @default(now()) @map("triggered_at")

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertRuleId])
  @@index([organizationId, userId])
  @@index([triggeredAt])
  @@index([wasViewed])
  @@map("alert_history")
}

// ---------------------------------------------------------------------------
// Spending Forecast models
// ---------------------------------------------------------------------------

model SpendingForecast {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  forecastType       String   // monthly, quarterly, annual
  category           String?  // null for overall forecast
  forecastStartDate  DateTime @map("forecast_start_date") @db.Date
  forecastEndDate    DateTime @map("forecast_end_date") @db.Date
  predictedAmount    BigInt   @map("predicted_amount") // in cents
  confidenceScore    Decimal  @map("confidence_score") @db.Decimal(3, 2) // 0.0 to 1.0
  dataPoints         Int      @default(0) @map("data_points") // how many historical data points used
  forecast           Json     // array of {date, amount, lower_bound, upper_bound}
  methodology        String   @default("linear_regression") // algorithm used
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, forecastType, category, forecastStartDate])
  @@index([organizationId, userId])
  @@index([forecastType])
  @@map("spending_forecasts")
}
