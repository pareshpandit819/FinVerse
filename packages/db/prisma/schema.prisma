// This is the Prisma schema for the Enterprise Financial Dashboard.
// All monetary values stored as BigInt (cents) — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js required models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core application models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       Membership[]
  plaidItems        PlaidItem[]
  auditLogs         AuditLog[]
  netWorthSnapshots NetWorthSnapshot[]
  goals             Goal[]
  budgets           Budget[]
  insights          Insight[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  mfaSecrets        MfaSecret[]
  auditLogs         AuditLog[]
  plaidItems        PlaidItem[]
  netWorthSnapshots NetWorthSnapshot[]
  goals             Goal[]
  budgets           Budget[]
  insights          Insight[]

  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id") @db.Uuid
  expires       DateTime
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model MfaSecret {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  encryptedSecret String   @map("encrypted_secret")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PlaidItem {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  encryptedAccessToken String    @map("encrypted_access_token")
  itemId               String    @unique @map("item_id")
  institutionId        String    @map("institution_id")
  institutionName      String    @map("institution_name")
  status               String    @default("active")
  consentExpiresAt     DateTime? @map("consent_expires_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  transactionCursor    String?   @map("transaction_cursor")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     PlaidAccount[]

  @@index([organizationId])
  @@index([userId])
  @@map("plaid_items")
}

model PlaidAccount {
  id               String   @id @default(uuid()) @db.Uuid
  plaidItemId      String   @map("plaid_item_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  accountId        String   @unique @map("account_id")
  name             String
  officialName     String?  @map("official_name")
  type             String
  subtype          String?
  mask             String?
  balanceCurrent   BigInt   @default(0) @map("balance_current")
  balanceAvailable BigInt?  @map("balance_available")
  balanceLimit     BigInt?  @map("balance_limit")
  isoCurrencyCode  String   @default("USD") @map("iso_currency_code")
  updatedAt        DateTime @updatedAt @map("updated_at")

  plaidItem    PlaidItem     @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  holdings     Holding[]
  liability    Liability?

  @@index([organizationId])
  @@index([plaidItemId])
  @@map("plaid_accounts")
}

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  plaidAccountId  String   @map("plaid_account_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  transactionId   String   @unique @map("transaction_id")
  amount          BigInt
  isoCurrencyCode String   @default("USD") @map("iso_currency_code")
  date            DateTime @db.Date
  name            String
  merchantName    String?  @map("merchant_name")
  paymentChannel  String?  @map("payment_channel")
  plaidCategories String[] @map("plaid_categories")
  customCategory  String?  @map("custom_category")
  pending         Boolean  @default(false)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([plaidAccountId])
  @@index([date])
  @@map("transactions")
}

model Security {
  id               String   @id @default(uuid()) @db.Uuid
  plaidSecurityId  String   @unique @map("plaid_security_id")
  name             String
  tickerSymbol     String?  @map("ticker_symbol")
  type             String
  isoCurrencyCode  String   @default("USD") @map("iso_currency_code")
  closePrice       BigInt?  @map("close_price")
  closePriceAsOf   DateTime? @map("close_price_as_of") @db.Date
  updatedAt        DateTime @updatedAt @map("updated_at")

  holdings Holding[]

  @@map("securities")
}

model Holding {
  id              String   @id @default(uuid()) @db.Uuid
  plaidAccountId  String   @map("plaid_account_id") @db.Uuid
  securityId      String   @map("security_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  quantity        Decimal  @db.Decimal(20, 8)
  institutionValue BigInt  @map("institution_value")
  costBasis       BigInt?  @map("cost_basis")
  isoCurrencyCode String   @default("USD") @map("iso_currency_code")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account  PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  security Security     @relation(fields: [securityId], references: [id])

  @@unique([plaidAccountId, securityId])
  @@index([organizationId])
  @@map("holdings")
}

model Liability {
  id                   String    @id @default(uuid()) @db.Uuid
  plaidAccountId       String    @unique @map("plaid_account_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  type                 String
  lastPaymentAmount    BigInt?   @map("last_payment_amount")
  lastPaymentDate      DateTime? @map("last_payment_date") @db.Date
  minimumPaymentAmount BigInt?   @map("minimum_payment_amount")
  nextPaymentDueDate   DateTime? @map("next_payment_due_date") @db.Date
  metadata             Json?
  updatedAt            DateTime  @updatedAt @map("updated_at")

  account PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("liabilities")
}

model NetWorthSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  totalAssets    BigInt   @map("total_assets")
  totalLiabilities BigInt @map("total_liabilities")
  netWorth       BigInt   @map("net_worth")
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  breakdown      Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

model Goal {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String
  targetAmount     BigInt   @map("target_amount")
  currentAmount    BigInt   @default(0) @map("current_amount")
  targetDate       DateTime @map("target_date") @db.Date
  contributionRate Decimal  @default(0) @map("contribution_rate") @db.Decimal(20, 2)
  linkedAccountIds String[] @map("linked_account_ids")
  isCompleted      Boolean  @default(false) @map("is_completed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("goals")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  month          Int
  year           Int
  rollover       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   BudgetCategory[]

  @@unique([organizationId, userId, month, year])
  @@map("budgets")
}

model BudgetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  category    String
  limitAmount BigInt   @map("limit_amount")
  spentAmount BigInt   @default(0) @map("spent_amount")
  updatedAt   DateTime @updatedAt @map("updated_at")

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@map("budget_categories")
}

model Insight {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String    @db.Text
  severity       String    @default("info")
  actionItems    String[]  @map("action_items")
  toolCallLog    Json      @map("tool_call_log")
  modelId        String    @map("model_id")
  promptHash     String    @map("prompt_hash")
  inputTokens    Int       @map("input_tokens")
  outputTokens   Int       @map("output_tokens")
  helpful        Boolean?
  generatedAt    DateTime  @default(now()) @map("generated_at")
  expiresAt      DateTime  @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([expiresAt])
  @@map("insights")
}
