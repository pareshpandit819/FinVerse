# =============================================================================
# Enterprise Financial Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Next.js public URL (used for OAuth callbacks, email links)
NEXTAUTH_URL=http://localhost:3000

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Next.js internal secret (same value as AUTH_SECRET is fine)
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://efd_user:efd_dev_password@localhost:5432/efd_dev

# Separate URL for direct connections (Prisma migrations bypass PgBouncer)
DIRECT_URL=postgresql://efd_user:efd_dev_password@localhost:5432/efd_dev

# Postgres credentials (used by docker-compose)
POSTGRES_USER=efd_user
POSTGRES_PASSWORD=efd_dev_password
POSTGRES_DB=efd_dev

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:efd_dev_redis@localhost:6379
REDIS_PASSWORD=efd_dev_redis

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# For local development, Mailhog is used (http://localhost:8025)
EMAIL_FROM=noreply@financialdashboard.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Plaid
# -----------------------------------------------------------------------------
# Obtain from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# AES-256-GCM encryption key for Plaid access tokens.
# Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=

# Plaid webhook URL (must be publicly reachable; use ngrok in development)
PLAID_WEBHOOK_URL=http://localhost:3001/webhooks/plaid

# -----------------------------------------------------------------------------
# MFA
# -----------------------------------------------------------------------------
# AES-256-GCM encryption key for TOTP secrets.
# Generate with: openssl rand -hex 32
MFA_SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Anthropic (Claude API)
# -----------------------------------------------------------------------------
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Per-user daily token budget (input + output combined)
AI_DAILY_TOKEN_BUDGET=100000

# -----------------------------------------------------------------------------
# OAuth — Google
# -----------------------------------------------------------------------------
# Obtain from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry DSN — obtain from https://sentry.io/
SENTRY_DSN=

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# Worker service
# -----------------------------------------------------------------------------
WORKER_PORT=3001
WORKER_HOST=0.0.0.0
